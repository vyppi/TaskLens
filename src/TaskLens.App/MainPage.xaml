<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaskLens_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TaskLens_App.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="Navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="My Day" Tag="My Day">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Inbox" Tag="Inbox">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Upcoming" Tag="Upcoming">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Completed" Tag="Completed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE73E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="AI Capture" Tag="AI Capture">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="AREAS" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Margin="12" Spacing="8">
                    <Button Click="AddArea_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" />
                            <TextBlock Text="New area" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="DeleteArea_Click"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.CanDeleteSelectedArea, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock Text="Delete selected area" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="TaskLens" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Local-first. Review before create." Opacity="0.65" FontSize="12" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid Padding="32,24,32,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.SelectedView, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock
                        Text="Turn scattered work into a clear next action."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,22,0,18" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        PlaceholderText="Add a task"
                        Text="{x:Bind ViewModel.QuickTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.AddTaskCommand}"
                        Content="Add task"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <Grid Grid.Row="2">
                    <StackPanel
                        Visibility="{x:Bind ViewModel.CaptureVisibility, Mode=OneWay}"
                        Spacing="14">
                        <Border
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="10">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Capture from text" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Paste meeting notes, a transcript, or everything on your mind. Nothing becomes a task until you review it."
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <InfoBar
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="Capture provider"
                                    Message="{x:Bind ViewModel.CaptureProviderDescription}" />
                                <TextBox
                                    AcceptsReturn="True"
                                    Height="180"
                                    PlaceholderText="Example: Action item: send the launch status update by Friday..."
                                    Text="{x:Bind ViewModel.CaptureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.ExtractCommand}"
                                    Content="Extract action items"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <ListView ItemsSource="{x:Bind ViewModel.Suggestions}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SuggestedTaskViewModel">
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="16"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind AreaName}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Metadata}" FontSize="12" Opacity="0.7" />
                                                <TextBlock Text="{x:Bind Explanation}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />
                                                <TextBlock Text="{x:Bind SourceExcerpt}" TextWrapping="Wrap" FontStyle="Italic" FontSize="12" Opacity="0.65" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.AcceptSuggestionsCommand}"
                            Content="Create selected tasks"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <ListView
                        x:Name="TaskList"
                        CanDragItems="True"
                        DragItemsStarting="TaskList_DragItemsStarting"
                        ItemsSource="{x:Bind ViewModel.VisibleTasks}"
                        SelectionMode="None"
                        Visibility="{x:Bind ViewModel.TaskListVisibility, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskCardViewModel">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16,12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            IsChecked="{x:Bind IsCompleted}"
                                            Click="TaskCompletion_Click"
                                            Tag="{x:Bind}" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind AreaName}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Metadata}" FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{x:Bind SourceDetail}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Click="EditTask_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Edit">
                                            <FontIcon Glyph="&#xE70F;" />
                                        </Button>
                                        <Button
                                            Grid.Column="3"
                                            Click="DeleteTask_Click"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Delete">
                                            <FontIcon Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <ProgressRing
                        HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Width="18"
                        Height="18" />
                    <TextBlock
                        Margin="28,0,0,0"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
